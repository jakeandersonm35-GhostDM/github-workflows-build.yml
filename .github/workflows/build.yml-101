name: Build Flutter APK

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4
      
      - name: Install unzip
        run: sudo apt-get update && sudo apt-get install -y unzip
      
      - name: Unzip Project
        run: unzip my_app.zip
        
      - name: Set up Java
        uses: actions/setup-java@v3
        with:
          distribution: 'zulu'
          java-version: '17'
          
      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: 'stable' # Using 'stable' is fine, the issue is with Gradle, not Flutter.

      # --- THIS IS THE FIX ---
      - name: Fix Gradle Distribution URL and Timeout
        run: |
          WRAPPER_FILE="my_app/android/gradle/wrapper/gradle-wrapper.properties"
          # Change the download URL to the more reliable services.gradle.org domain
          sed -i 's|https\\://github.com/gradle/gradle-distributions/releases/download/v9.3.1/gradle-9.3.1-all.zip|https\\://services.gradle.org/distributions/gradle-9.3.1-all.zip|' $WRAPPER_FILE
          # Increase the network timeout to 120 seconds (default is 10s)
          echo "networkTimeout=120000" >> $WRAPPER_FILE
      # --- END OF FIX ---
          
      - name: Get Dependencies
        run: |
          cd my_app
          flutter pub get
          
      - name: Build APK
        run: |
          cd my_app
          flutter build apk --debug
          
      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: my-app-apk
          path: my_app/build/app/outputs/flutter-apk/app-debug.apk
